{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./apps/frontend/src/*"]
    }
  },
  "include": [
    "apps/frontend/**/*.ts",
    "apps/frontend/**/*.tsx",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules/*"]
}
